<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One target per Rhino major version:
      net48    Rhino 7    (.NET Framework 4.8)
      net8.0   Rhino 8.21 or later (.NET 8, the default runtime since Rhino 8.20)
      net10.0  Rhino 9    (.NET 10)
    To drop a Rhino version, remove its target here and its profile in .vscode/launch.json.
    The matching ItemGroup below becomes inactive and can be removed as well.
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Grasshopper loads files with the .gha extension. -->
    <TargetExt>.gha</TargetExt>
    <!-- net8.0 is past its Microsoft support date; it remains the runtime of Rhino 8. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0</Version>
    <Title>MyPlugin</Title>
    <Company>MyPlugin Authors</Company>
    <Description>Grasshopper plug-in MyPlugin.</Description>
  </PropertyGroup>

  <!--
    Compile-time references only (ExcludeAssets="runtime"). Rhino provides Grasshopper, RhinoCommon and
    System.Drawing at run time. Each target compiles against the oldest supported release of its Rhino
    version, so the output loads in every later service release of that version.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Grasshopper" Version="7.0.20314.3001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Grasshopper" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.34" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Grasshopper" Version="9.0.26300.9401" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
